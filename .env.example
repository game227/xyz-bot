# Django
SECRET_KEY=change-me-generate-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — SQLite ishlatiladi (default). Postgres uchun USE_POSTGRES=True qiling.
USE_POSTGRES=False
# DB_NAME=xyzbot
# DB_USER=xyzbot_user
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

TIME_ZONE=Asia/Tashkent

# Telegram bot — token @BotFather'dan olinadi. HECH QACHON kodga yozmang.
TELEGRAM_BOT_TOKEN=
SITE_BASE_URL=http://localhost:8000
TELEGRAM_VIDEO_MAX_MB=45

# Vergul bilan ajratilgan Telegram ID'lar — botda avtomatik ADMIN bo'ladi.
ADMIN_TELEGRAM_IDS=

# Bot rejimi: polling (dev, default) yoki webhook (production, HTTPS kerak)
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_PATH=/telegram/webhook/
WEBHOOK_SECRET=
WEBHOOK_LISTEN_HOST=0.0.0.0
WEBHOOK_LISTEN_PORT=8081
